# Global project configuration (sourced by scripts/*.sh)

# --- Force field ---
FORCEFIELD="amber99sb-ildn"
WATERMODEL="tip3p"
# Backward-compatible aliases
PROTEIN_FORCEFIELD="${FORCEFIELD}"
WATER_MODEL="${WATERMODEL}"

# --- Ligand ---
LIGAND_RESNAME="UNL"
LIGAND_NET_CHARGE="0"
ACPYPE_CHARGE_METHOD="bcc"

# --- Input layout ---
INPUT_POSE_FILENAME="pose_1_complex.pdb"
CLEANED_COMPLEX_FILENAME="docked_complex_cleaned.pdb"

# --- Box / ions ---
BOX_TYPE="dodecahedron"
BOX_DISTANCE="1.0"
BOX_DISTANCE_NM="${BOX_DISTANCE}"
ION_CONCENTRATION="0.15"
SALT_CONC_M="${ION_CONCENTRATION}"

# --- Production MD ---
PRODUCTION_MDP="md_200ps.mdp"
PRODUCTION_DEFFNM="md_200ps"

# --- GPU mdrun ---
# Prefer CUDA GROMACS from install/01 (not conda gmx). Sourced at start of run_one_system.sh.
GMX_CUDA_PREFIX="${HOME}/apps/gromacs-2026.2-cuda"
GMX_GPU_ID="0"

# Primary flags. Avoid -update gpu / -bonded gpu unless you verified them (often cause silent CPU fallback).
GMX_MDRUN_GPU_FLAGS="-nb gpu -pme gpu -pin on"
# If primary fails, script tries this before CPU (empty = skip second GPU attempt).
GMX_MDRUN_GPU_FLAGS_FALLBACK="-nb gpu -pin on"
# yes = retry on CPU if GPU fails; no = stop with error (use when debugging GPU).
GMX_MDRUN_ALLOW_CPU_FALLBACK="yes"
